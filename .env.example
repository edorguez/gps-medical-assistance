# Compose project name
COMPOSE_PROJECT_NAME=gps-medical-assistance

# Local binding. Keep 127.0.0.1 when Cloudflare Tunnel is the public entrypoint.
BIND_IP=127.0.0.1
EDGE_PORT=8082

# Persistent data
DATA_ROOT=/opt/docker-projects-data/gps-medical-assistance

# PostgreSQL
POSTGRES_DB=GpsMedicalAssistanceDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Twilio SMS (optional; leave empty to disable SMS sending)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
